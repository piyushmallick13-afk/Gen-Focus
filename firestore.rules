rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{testId} {
      allow read: if true;
    }
    match /products/{productId} {
      allow read, write: if true;
    }
    match /nav_links/{linkId} {
      allow read, write: if true;
    }
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    match /app_metadata/{docId} {
      allow read, write: if true;
    }
  }
}

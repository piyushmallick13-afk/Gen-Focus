rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'description', 'price', 'imageUrl', 'category'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.price is string && data.price.size() <= 50
        && data.imageUrl is string && data.imageUrl.size() <= 500000
        && data.category is string && data.category.size() <= 100
        && (!('mrp' in data) || (data.mrp is string && data.mrp.size() <= 50))
        && (!('discount' in data) || (data.discount is string && data.discount.size() <= 20))
        && (!('affiliateUrl' in data) || (data.affiliateUrl is string && data.affiliateUrl.size() <= 1000))
        && (!('subCategory' in data) || (data.subCategory is string && data.subCategory.size() <= 100))
        && (!('imageBgColor' in data) || (data.imageBgColor is string && data.imageBgColor.size() <= 50))
        && (!('rating' in data) || data.rating is number)
        && (!('type' in data) || data.type in ['affiliate', 'buy'])
        && (!('hasSizes' in data) || data.hasSizes is bool)
        && (!('additionalImages' in data) || (data.additionalImages is list && data.additionalImages.size() <= 10));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 300))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('image' in data) || (data.image is string && data.image.size() <= 500000))
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 500000))
        && (!('order' in data) || data.order is number)
        && (!('popularTags' in data) || (data.popularTags is list && data.popularTags.size() <= 20))
        && (!('groups' in data) || (data.groups is list && data.groups.size() <= 10));
    }

    function isValidNavLink(data) {
      return data.keys().hasAll(['id', 'label', 'url', 'section'])
        && data.id is string && data.id.size() <= 128
        && data.label is string && data.label.size() > 0 && data.label.size() <= 100
        && data.url is string && data.url.size() <= 500
        && data.section in ['explore', 'legal'];
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'items', 'totalAmount', 'customer'])
        && data.id is string && data.id.size() <= 128
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.totalAmount is number
        && data.customer is map;
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isValidProduct(incoming());
      allow update: if isValidId(productId) && isValidProduct(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(productId);
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isValidCategory(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(categoryId);
    }

    // Navigation links
    match /nav_links/{linkId} {
      allow read: if true;
      allow create: if isValidId(linkId) && isValidNavLink(incoming());
      allow update: if isValidId(linkId) && isValidNavLink(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(linkId);
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isValidOrder(incoming()) && incoming().id == existing().id;
      allow delete: if false;
    }
  }
}

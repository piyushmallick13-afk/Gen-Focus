{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Products available in the curated store",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "description": "Product name" },
        "description": { "type": "string", "description": "Product description" },
        "price": { "type": "string", "description": "Formatted price string" },
        "mrp": { "type": "string", "description": "Maximum retail price" },
        "discount": { "type": "string", "description": "Discount percentage text" },
        "imageUrl": { "type": "string", "description": "Main image URL or data URI" },
        "category": { "type": "string", "description": "Product category" },
        "rating": { "type": "number", "description": "Average review rating" },
        "imageBgColor": { "type": "string", "description": "Background accent color class" },
        "affiliateUrl": { "type": "string", "description": "Affiliate link URL" },
        "type": { "type": "string", "enum": ["affiliate", "buy"], "description": "Product type" },
        "hasSizes": { "type": "boolean", "description": "Whether size selection is available" },
        "additionalImages": { "type": "array", "description": "Additional gallery images" }
      },
      "required": ["id", "name", "price", "imageUrl", "category"]
    },
    "NavLink": {
      "title": "NavLink",
      "description": "Navigation link in header or footer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Link ID" },
        "label": { "type": "string", "description": "Display label" },
        "url": { "type": "string", "description": "Target URL or path" },
        "section": { "type": "string", "enum": ["explore", "legal"], "description": "Nav section" }
      },
      "required": ["id", "label", "url", "section"]
    },
    "CategoryDetail": {
      "title": "CategoryDetail",
      "description": "Department or category details and structure",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Category ID" },
        "name": { "type": "string", "description": "Category name" },
        "tagline": { "type": "string", "description": "Tagline" },
        "description": { "type": "string", "description": "Description" },
        "image": { "type": "string", "description": "Featured image URL" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of lifestyle products"
    },
    "/nav_links/{linkId}": {
      "schema": "NavLink",
      "description": "Customizable navigation and footer links"
    },
    "/categories/{categoryId}": {
      "schema": "CategoryDetail",
      "description": "Department navigation categories"
    }
  }
}

{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Products available in the store catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique product ID" },
        "name": { "type": "string", "description": "Product title" },
        "description": { "type": "string", "description": "Product description" },
        "price": { "type": "string", "description": "Formatted price string" },
        "mrp": { "type": "string", "description": "Maximum retail price" },
        "discount": { "type": "string", "description": "Discount badge text" },
        "imageUrl": { "type": "string", "description": "Product image URL or data URL" },
        "affiliateUrl": { "type": "string", "description": "Affiliate destination or product URL" },
        "category": { "type": "string", "description": "Product category" },
        "imageBgColor": { "type": "string", "description": "Background color tailwind class" },
        "rating": { "type": "number", "description": "Product rating" },
        "type": { "type": "string", "description": "Interaction mode: affiliate or direct buy" },
        "hasSizes": { "type": "boolean", "description": "Whether size selection is available" },
        "additionalImages": {
          "type": "array",
          "description": "Additional gallery image URLs"
        }
      },
      "required": ["name", "description", "price", "imageUrl", "category"]
    },
    "NavLink": {
      "title": "NavLink",
      "description": "Navigation and footer links",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique nav link ID" },
        "label": { "type": "string", "description": "Display label" },
        "url": { "type": "string", "description": "Link target URL" },
        "section": { "type": "string", "description": "Navigation section (explore or legal)" }
      },
      "required": ["label", "url", "section"]
    },
    "SystemState": {
      "title": "SystemState",
      "description": "System state to prevent repeated seeding when products are deleted",
      "type": "object",
      "properties": {
        "seeded": { "type": "boolean" },
        "initializedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of store products"
    },
    "/nav_links/{linkId}": {
      "schema": "NavLink",
      "description": "Collection of navigation and footer links"
    },
    "/system/{docId}": {
      "schema": "SystemState",
      "description": "System initialization state"
    }
  }
}

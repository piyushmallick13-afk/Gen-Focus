{
  "collections": [
    {
      "name": "products",
      "description": "Products available in the store",
      "fields": [
        { "name": "name", "type": "string", "description": "Product name" },
        { "name": "description", "type": "string", "description": "Product description" },
        { "name": "price", "type": "string", "description": "Product price" },
        { "name": "mrp", "type": "string", "description": "Maximum retail price", "required": false },
        { "name": "imageUrl", "type": "string", "description": "Product image URL" },
        { "name": "category", "type": "string", "description": "Product category" },
        { "name": "rating", "type": "number", "description": "Product rating", "required": false },
        { "name": "imageBgColor", "type": "string", "description": "Background color class", "required": false }
      ],
      "access": {
        "create": "public",
        "read": "public",
        "update": "public",
        "delete": "public"
      }
    },
    {
      "name": "categories",
      "description": "Categories available in the store",
      "fields": [
        { "name": "name", "type": "string", "description": "Category name" },
        { "name": "description", "type": "string", "description": "Category description", "required": false },
        { "name": "imageUrl", "type": "string", "description": "Category banner or preview image", "required": false },
        { "name": "slug", "type": "string", "description": "Category slug", "required": false }
      ],
      "access": {
        "create": "public",
        "read": "public",
        "update": "public",
        "delete": "public"
      }
    },
    {
      "name": "nav_links",
      "description": "Navigation links in header/footer",
      "fields": [
        { "name": "label", "type": "string", "description": "Link label" },
        { "name": "url", "type": "string", "description": "Target URL" },
        { "name": "section", "type": "string", "description": "explore or legal" }
      ],
      "access": {
        "create": "public",
        "read": "public",
        "update": "public",
        "delete": "public"
      }
    }
  ]
}
